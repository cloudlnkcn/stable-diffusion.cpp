+namespace {
+// WebM demuxers in browsers (Chromium, WebKit) only decode Opus/Vorbis audio
+// tracks and silently drop A_PCM/INT/LIT, so a PCM-encoded video plays muted
+// in browser-based players. Encode the generated audio to Opus instead. The
+// Opus API only accepts 48 kHz (or lower) input, so the source audio is
+// resampled with a 4-point Catmull-Rom cubic interpolator first.
+
+constexpr int kOpusSampleRate    = 48000;
+constexpr int kOpusFrameSize     = 960;       // 20 ms at 48 kHz
+constexpr uint64_t kOpusFrameNs  = 20000000;  // 20 ms in nanoseconds
+
+struct OpusAudioData {
+    std::vector<std::vector<uint8_t>> packets;  // 20 ms Opus packets at 48 kHz
+    int pre_skip_ns = 0;                        // encoder lookahead, nanoseconds
+    int channels    = 0;
+};
+
+OpusAudioData encode_audio_to_opus_packets(const sd_audio_t* audio) {
+    OpusAudioData result;
+    if (audio == nullptr || audio->data == nullptr || audio->sample_count == 0
+            || audio->sample_rate <= 0 || audio->channels <= 0) {
+        return result;
+    }
+
+    // Downmix anything above stereo; the audio VAE pipeline outputs mono/stereo.
+    const int out_channels = audio->channels == 1 ? 1 : 2;
+
+    const uint64_t in_frames = audio->sample_count;
+
+    // Pre-downmix to out_channels so the resampler reads a compact buffer.
+    std::vector<float> src(static_cast<size_t>(in_frames) * out_channels);
+    for (uint64_t i = 0; i < in_frames; ++i) {
+        const float* in = audio->data + i * audio->channels;
+        if (out_channels == 1) {
+            float sum = 0.0f;
+            for (int ch = 0; ch < audio->channels; ++ch) sum += in[ch];
+            src[i] = sum / audio->channels;
+        } else {
+            src[i * 2 + 0] = in[0];
+            src[i * 2 + 1] = in[1];
+        }
+    }
+
+    int err = OPUS_OK;
+    OpusEncoder* encoder = opus_encoder_create(kOpusSampleRate, out_channels, OPUS_APPLICATION_AUDIO, &err);
+    if (encoder == nullptr || err != OPUS_OK) {
+        fprintf(stderr, "Error: Failed to create Opus encoder (%d).\n", err);
+        return result;
+    }
+    opus_encoder_ctl(encoder, OPUS_SET_BITRATE(out_channels == 2 ? 128000 : 64000));
+
+    opus_int32 lookahead = 0;
+    opus_encoder_ctl(encoder, OPUS_GET_LOOKAHEAD(&lookahead));
+    result.pre_skip_ns = static_cast<int>(lookahead) * 1000000000ll / kOpusSampleRate;
+    result.channels    = out_channels;
+
+    // Resample to 48 kHz interleaved float frames.
+    const uint64_t out_frames = static_cast<uint64_t>(static_cast<double>(in_frames - 1) * kOpusSampleRate / audio->sample_rate);
+    std::vector<float> resampled(static_cast<size_t>(out_frames) * out_channels);
+    const double step = static_cast<double>(audio->sample_rate) / kOpusSampleRate;
+    for (uint64_t i = 0; i < out_frames; ++i) {
+        const double src_pos   = i * step;
+        const uint64_t src_idx = static_cast<uint64_t>(src_pos);
+        const float frac       = static_cast<float>(src_pos - src_idx);
+        for (int ch = 0; ch < out_channels; ++ch) {
+            // Catmull-Rom needs one sample on either side; clamp at the edges.
+            const uint64_t i1 = src_idx;
+            const uint64_t i0 = i1 > 0 ? i1 - 1 : 0;
+            const uint64_t i2 = i1 + 1 < in_frames ? i1 + 1 : in_frames - 1;
+            const uint64_t i3 = i1 + 2 < in_frames ? i1 + 2 : in_frames - 1;
+            const float s0 = src[i0 * out_channels + ch];
+            const float s1 = src[i1 * out_channels + ch];
+            const float s2 = src[i2 * out_channels + ch];
+            const float s3 = src[i3 * out_channels + ch];
+            const float a  = -0.5f * s0 + 1.5f * s1 - 1.5f * s2 + 0.5f * s3;
+            const float b  = s0 - 2.5f * s1 + 2.0f * s2 - 0.5f * s3;
+            const float c  = -0.5f * s0 + 0.5f * s2;
+            resampled[i * out_channels + ch] = std::clamp(((a * frac + b) * frac + c) * frac + s1, -1.0f, 1.0f);
+        }
+    }
+
+    for (uint64_t offset = 0; offset + kOpusFrameSize <= out_frames; offset += kOpusFrameSize) {
+        std::vector<uint8_t> packet(4000);  // upper bound for one Opus packet
+        const opus_int32 nbytes = opus_encode_float(encoder,
+                                                     resampled.data() + offset * out_channels,
+                                                     kOpusFrameSize,
+                                                     packet.data(),
+                                                     static_cast<opus_int32>(packet.size()));
+        if (nbytes < 0) {
+            fprintf(stderr, "Error: Opus encoding failed (%d).\n", nbytes);
+            opus_encoder_destroy(encoder);
+            result.packets.clear();
+            return result;
+        }
+        packet.resize(static_cast<size_t>(nbytes));
+        result.packets.push_back(std::move(packet));
+    }
+
+    opus_encoder_destroy(encoder);
+    return result;
+}
+
+// RFC 7845 section 5.1 OpusHead packet, used as the Matroska CodecPrivate.
+std::vector<uint8_t> build_opus_head(int channels, int pre_skip_ns) {
+    std::vector<uint8_t> head(19, 0);
+    memcpy(head.data(), "OpusHead", 8);
+    head[8] = 1;  // version
+    head[9] = static_cast<uint8_t>(channels);
+    const uint16_t pre_skip_48k = static_cast<uint16_t>(
+        static_cast<int64_t>(pre_skip_ns) * kOpusSampleRate / 1000000000ll);
+    head[10] = static_cast<uint8_t>(pre_skip_48k & 0xFF);
+    head[11] = static_cast<uint8_t>((pre_skip_48k >> 8) & 0xFF);
+    head[12] = static_cast<uint8_t>(kOpusSampleRate & 0xFF);
+    head[13] = static_cast<uint8_t>((kOpusSampleRate >> 8) & 0xFF);
+    head[14] = static_cast<uint8_t>((kOpusSampleRate >> 16) & 0xFF);
+    head[15] = static_cast<uint8_t>((kOpusSampleRate >> 24) & 0xFF);
+    // output gain (2 bytes) and channel mapping family (1 byte) stay zero
+    return head;
+}
