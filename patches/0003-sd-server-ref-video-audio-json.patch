+// Decode a base64 (or data-URL) encoded RIFF/WAVE payload into an owned
+// audio buffer. Mirrors decode_base64_image for audio reference inputs.
+static bool decode_base64_audio(const std::string& encoded_input, SDAudioOwner& out_audio) {
+    std::string encoded = encoded_input;
+    auto comma_pos      = encoded.find(',');
+    if (comma_pos != std::string::npos) {
+        encoded = encoded.substr(comma_pos + 1);
+    }
+
+    std::vector<uint8_t> wav_bytes = decode_base64_bytes(encoded);
+    if (wav_bytes.empty()) {
+        return false;
+    }
+
+    std::vector<float> samples;
+    uint32_t sample_rate = 0;
+    uint32_t channels    = 0;
+    if (!load_wav_from_memory(wav_bytes.data(), wav_bytes.size(), samples, sample_rate, channels)) {
+        return false;
+    }
+    out_audio.reset(std::move(samples), sample_rate, channels);
+    return true;
+}
+
+static bool parse_audio_array_json_field(const json& parent,
+                                         const char* key,
+                                         std::vector<SDAudioOwner>& out_audios) {
+    if (!parent.contains(key)) {
+        return true;
+    }
+    if (parent.at(key).is_null()) {
+        out_audios.clear();
+        return true;
+    }
+    if (!parent.at(key).is_array()) {
+        return false;
+    }
+
+    out_audios.clear();
+    for (const auto& item : parent.at(key)) {
+        if (!item.is_string()) {
+            return false;
+        }
+        SDAudioOwner audio;
+        if (!decode_base64_audio(item.get<std::string>(), audio)) {
+            return false;
+        }
+        out_audios.push_back(std::move(audio));
+    }
+    return true;
+}
+
+// Reference videos arrive as an array of objects:
+//   { "frames": ["<base64 image>", ...], "fps": 24, "audio": "<base64 wav>" }
+// frames is required; fps defaults to 24 and audio (a soundtrack paired with
+// this reference video) is optional.
+static bool parse_ref_videos_json_field(const json& parent,
+                                        const char* key,
+                                        std::vector<std::vector<SDImageOwner>>& out_videos,
+                                        std::vector<int>& out_fps,
+                                        std::vector<SDAudioOwner>& out_audios) {
+    if (!parent.contains(key)) {
+        return true;
+    }
+    if (parent.at(key).is_null()) {
+        out_videos.clear();
+        out_fps.clear();
+        out_audios.clear();
+        return true;
+    }
+    if (!parent.at(key).is_array()) {
+        return false;
+    }
+
+    out_videos.clear();
+    out_fps.clear();
+    out_audios.clear();
+    for (const auto& item : parent.at(key)) {
+        if (!item.is_object() || !item.contains("frames") || !item.at("frames").is_array()
+                || item.at("frames").empty()) {
+            return false;
+        }
+        std::vector<SDImageOwner> frames;
+        for (const auto& frame : item.at("frames")) {
+            if (!frame.is_string()) {
+                return false;
+            }
+            SDImageOwner image;
+            if (!decode_base64_image(frame.get<std::string>(), 0, 0, 0, image)) {
+                return false;
+            }
+            frames.push_back(std::move(image));
+        }
+        out_videos.push_back(std::move(frames));
+
+        int fps = 24;
+        if (item.contains("fps")) {
+            if (!item.at("fps").is_number_integer() || item.at("fps").get<int>() <= 0) {
+                return false;
+            }
+            fps = item.at("fps").get<int>();
+        }
+        out_fps.push_back(fps);
+
+        SDAudioOwner audio;
+        if (item.contains("audio")) {
+            if (!item.at("audio").is_string()) {
+                return false;
+            }
+            if (!decode_base64_audio(item.at("audio").get<std::string>(), audio)) {
+                return false;
+            }
+        }
+        out_audios.push_back(std::move(audio));
+    }
+    return true;
+}
